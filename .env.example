# ─────────────────────────────────────────────────────────────
# MintedScale — copy to .env.local and fill in.
# Everything here is optional: with nothing set the site still
# runs and validates applications, it just logs the emails to
# the server console instead of sending them.
# ─────────────────────────────────────────────────────────────

# ── Where applications land (receiving) ──────────────────────
# Reply-to on every outgoing mail points here, so creators replying to a
# no-reply sender still reach a real inbox.
CONTACT_INBOX=anel@mintedscale.com

# ── Email delivery (sending) ─────────────────────────────────
# Leave EMAIL_PROVIDER unset to auto-detect from whichever key is present.
# EMAIL_PROVIDER=resend
EMAIL_FROM="MintedScale <no-reply@mintedscale.com>"

# Resend — https://resend.com/api-keys (verify your domain first)
RESEND_API_KEY=

# SendGrid — alternative to Resend
SENDGRID_API_KEY=

# ── Google Calendar ──────────────────────────────────────────
# Create a service account in Google Cloud, enable the Google Calendar API,
# then share your calendar with the service account address and give it
# "Make changes to events".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole PEM on one line with literal \n between lines, in quotes.
GOOGLE_PRIVATE_KEY=""
# The calendar bookings are written to — your address, or a calendar ID.
GOOGLE_CALENDAR_ID=anel@mintedscale.com

# Google Workspace only. With domain-wide delegation the service account can
# act as you, which is what lets bookings invite the creator and generate a
# Google Meet link. Leave blank on a personal Gmail account.
GOOGLE_IMPERSONATED_USER=

# Optional: your Google Calendar appointment schedule page. When set, a
# "Prefer Google?" link appears beneath the scheduler.
NEXT_PUBLIC_GOOGLE_APPOINTMENT_URL=

# ── Studio hours ─────────────────────────────────────────────
BOOKING_TIMEZONE=Europe/Berlin
BOOKING_DURATION_MINUTES=45
BOOKING_LEAD_TIME_HOURS=24
BOOKING_HORIZON_DAYS=21
